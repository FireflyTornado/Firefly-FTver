---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	formatTripDateRange,
	getTripCategories,
	getTripYearKeys,
	getTripYears,
	type TripRecord,
	tripsFromContent,
	tripToClient,
} from "@/utils/places-utils";

if (!siteConfig.pages.places) {
	return Astro.redirect("/404/");
}

const now = new Date();
const currentYear = now.getFullYear();

const tripEntries = await getCollection("places");
const allTrips: TripRecord[] = tripsFromContent(
	tripEntries.map((entry) => ({ id: entry.id, ...entry.data })),
);

const sortedTrips = [...allTrips].sort(
	(a, b) => b.date.getTime() - a.date.getTime(),
);

const tripYears = getTripYears(allTrips);
const tripCategories = getTripCategories(allTrips);

const totalVisitCount = sortedTrips.length;
const thisYearVisitCount = sortedTrips.filter((trip) => {
	const y = trip.date.getFullYear();
	const endY = trip.endDate?.getFullYear() ?? y;
	return y <= currentYear && endY >= currentYear;
}).length;
const uniqueLocationCount = new Set(
	sortedTrips.flatMap((trip) =>
		trip.locations.map(
			(location) => `${location.name.trim()}|${location.lng}|${location.lat}`,
		),
	),
).size;
const uniqueProvinceCount = new Set(
	sortedTrips
		.flatMap((trip) =>
			trip.locations.map((location) => location.province?.trim() || ""),
		)
		.filter(Boolean),
).size;
const latestTrip = sortedTrips[0];

const clientSortedTrips = sortedTrips.map((trip, index) =>
	tripToClient(trip, index),
);

const displayTitle = i18n(I18nKey.placesTitle);
const displaySubtitle = i18n(I18nKey.placesSubtitle);
const ownerLocation = siteConfig.placesMap?.ownerLocation ?? null;
const amapKey = siteConfig.placesMap?.amapKey?.trim() || "";
const amapSecurityJsCode =
	siteConfig.placesMap?.amapSecurityJsCode?.trim() || "";
const reverseGeocode = siteConfig.placesMap?.reverseGeocode === true;
const areaHighlightEnabled = siteConfig.placesMap?.areaHighlight !== false;
const configuredDistrictQueryInterval = Number(
	siteConfig.placesMap?.districtQueryInterval,
);
const districtQueryInterval = Number.isFinite(configuredDistrictQueryInterval)
	? Math.max(0, configuredDistrictQueryInterval)
	: 400;
const placesDevMode = import.meta.env.DEV;

const placesI18n = {
	mapLoadFailed: i18n(I18nKey.placesMapLoadFailed),
	needAmapKey: i18n(I18nKey.placesNeedAmapKey),
	filterAll: i18n(I18nKey.placesFilterAllFootprints),
	clusterDisplay: i18n(I18nKey.placesClusterDisplay),
	ownerLocation: i18n(I18nKey.placesMapOwnerLocation),
	clusterTrips: i18n(I18nKey.placesClusterTrips),
	locations: i18n(I18nKey.placesLocationCount),
};
---

<MainGridLayout title={displayTitle} description={displaySubtitle}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 py-6 md:px-9 relative w-full overflow-hidden">

      <div class="places-hero mb-8">
        <div class="places-hero-glow" aria-hidden="true"></div>
        <div class="relative z-1 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div class="flex items-start gap-4">
            <div class="places-hero-icon">
              <Icon name="material-symbols:explore" is:inline class="text-[1.6rem]" />
            </div>
            <div>
              <h1 data-pagefind-meta="title" data-pagefind-weight="10" class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-neutral-100 tracking-tight">{displayTitle}</h1>
              <p class="text-sm md:text-base text-neutral-600 dark:text-neutral-400 mt-1 max-w-xl">{displaySubtitle}</p>
            </div>
          </div>
          {uniqueProvinceCount > 0 && (
            <div class="places-hero-badge">
              <Icon name="material-symbols:flag" is:inline class="text-base" />
              <span>{i18n(I18nKey.placesVisitedProvinces)} <strong>{uniqueProvinceCount}</strong></span>
            </div>
          )}
        </div>
      </div>

      <div class="places-stats mb-8">
        <div class="places-stat-card">
          <div class="places-stat-value">{uniqueLocationCount}</div>
          <div class="places-stat-label dark:text-neutral-400">{i18n(I18nKey.placesStatLocationsUnit)}</div>
        </div>
        <div class="places-stat-card">
          <div class="places-stat-value">{totalVisitCount}</div>
          <div class="places-stat-label dark:text-neutral-400">{i18n(I18nKey.placesStatVisitsUnit)}</div>
        </div>
        <div class="places-stat-card">
          <div class="places-stat-value">{thisYearVisitCount}</div>
          <div class="places-stat-label dark:text-neutral-400">{i18n(I18nKey.placesStatThisYearUnit)}</div>
        </div>
      </div>

      {latestTrip && (
        <article class="places-latest mb-8">
          <div class="places-latest-label">
            <Icon name="material-symbols:near-me" is:inline class="text-sm" />
            {i18n(I18nKey.placesLatestTrip)}
          </div>
          <div class="places-latest-body">
            <h3 class="places-latest-title dark:text-neutral-100">
              {latestTrip.title}
            </h3>
            {latestTrip.description && (
              <p class="places-latest-exp dark:text-neutral-400">{latestTrip.description}</p>
            )}
            <div class="places-latest-meta dark:text-neutral-400">
              <time datetime={latestTrip.date.toISOString().slice(0, 10)}>
                {formatTripDateRange(latestTrip)}
              </time>
              {latestTrip.category && <span class="place-source-tag">{latestTrip.category}</span>}
            </div>
          </div>
        </article>
      )}

      <div class="mb-8">
        <h2 class="places-section-title dark:text-neutral-100">{i18n(I18nKey.placesMap)}</h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-4">{displaySubtitle}</p>

        <div class="places-map-shell">
          <div class="places-map-frame">
            <div class="places-map-filters" id="places-map-filters" role="tablist">
              <button type="button" class="places-filter-chip is-active" data-filter="all">
                {i18n(I18nKey.placesFilterAllFootprints)}
              </button>
              {tripYears.map((year) => (
                <button type="button" class="places-filter-chip" data-filter={`year:${year}`}>
                  {year}
                </button>
              ))}
              {tripCategories.map((cat) => (
                <button type="button" class="places-filter-chip" data-filter={`cat:${cat}`}>
                  {cat}
                </button>
              ))}
            </div>
            <div id="places-amap" class="places-amap-canvas"></div>
            <div class="places-map-loading" id="places-map-loading">
              <Icon name="material-symbols:map" is:inline class="text-3xl opacity-40 animate-pulse" />
            </div>
            <div class="places-map-controls" id="places-map-controls">
              <button type="button" class="places-map-ctrl" id="places-ctrl-fullscreen" title={i18n(I18nKey.placesFullscreen)} aria-label={i18n(I18nKey.placesFullscreen)}>
                <Icon name="material-symbols:fullscreen" is:inline class="text-[1.15rem]" />
              </button>
              <button type="button" class="places-map-ctrl" id="places-ctrl-refresh" title={i18n(I18nKey.placesRefresh)} aria-label={i18n(I18nKey.placesRefresh)}>
                <Icon name="material-symbols:refresh" is:inline class="text-[1.15rem]" />
              </button>
              <button type="button" class="places-map-ctrl" id="places-ctrl-zoom-in" title="+" aria-label="zoom in">
                <Icon name="material-symbols:add" is:inline class="text-[1.15rem]" />
              </button>
              <button type="button" class="places-map-ctrl" id="places-ctrl-zoom-out" title="−" aria-label="zoom out">
                <Icon name="material-symbols:remove" is:inline class="text-[1.15rem]" />
              </button>
            </div>
            <div class="places-map-toggles">
              <label class="places-toggle places-toggle--cluster">
                <span>{i18n(I18nKey.placesClusterDisplay)}</span>
                <input type="checkbox" id="places-toggle-cluster" checked />
              </label>
            </div>
          </div>
        </div>
        <p class="mt-3 text-xs text-neutral-400 dark:text-neutral-500 text-center">{i18n(I18nKey.placesMapCredit)}</p>
      </div>

      <div id="places-trip-list-view">
        <div id="places-city-context" class="places-city-context" hidden>
          <button type="button" class="places-context-link" data-city-overview>
            {i18n(I18nKey.placesBackToTrips)}
          </button>
          <span aria-hidden="true">/</span>
          <strong id="places-city-name" class="dark:text-neutral-100"></strong>
        </div>
        <h2 class="places-section-title dark:text-neutral-100">{i18n(I18nKey.placesList)}</h2>
        {sortedTrips.length === 0 ? (
          <div class="places-empty">
            <p class="text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.placesNoData)}</p>
            <p class="text-sm text-neutral-400 dark:text-neutral-500 mt-2">{i18n(I18nKey.placesNoDataHint)}</p>
          </div>
        ) : (
          <div class="places-grid" id="places-list">
            {sortedTrips.map((trip, index) => (
              <article
                class="place-card trip-card"
                style={`--stagger: ${index * 0.04}s`}
                data-years={getTripYearKeys(trip).join(",")}
                data-category={trip.category}
                data-trip-id={trip.id}
                role="button"
                tabindex="0"
              >
                <div class="place-card-body">
                  <div class="place-card-pin">
                    <Icon name="material-symbols:luggage" is:inline class="text-lg" />
                  </div>
                  <div class="place-card-content">
                    <h3 class="place-name dark:text-neutral-100">{trip.title}</h3>
                    <time class="place-date dark:text-neutral-100" datetime={trip.date.toISOString().slice(0, 10)}>
                      {formatTripDateRange(trip)}
                    </time>
                    <div class="trip-card-tags">
                      {trip.category && <span class="place-source-tag dark:text-neutral-400">{trip.category}</span>}
                      {trip.tags.map((tag) => <span class="place-source-tag dark:text-neutral-400">{tag}</span>)}
                    </div>
                    {trip.description && <p class="place-exp trip-card-summary dark:text-neutral-100">{trip.description}</p>}
                    <p class="trip-card-location-count dark:text-neutral-400">
                      {trip.locations.length} {i18n(I18nKey.placesLocationCount)}
                    </p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>

      <div id="places-trip-detail-view" hidden>
        {sortedTrips.map((trip) => (
            <article class="trip-detail" data-trip-detail-id={trip.id} hidden>
              <div class="trip-detail-actions">
                <button type="button" class="trip-detail-back" data-trip-back>
                  <Icon name="material-symbols:arrow-back-rounded" is:inline />
                  <span data-trip-back-label>{i18n(I18nKey.placesBackToTrips)}</span>
                </button>
                <button type="button" class="trip-detail-overview" data-trip-overview hidden>
                  {i18n(I18nKey.placesBackToTrips)}
                </button>
              </div>
              <p class="trip-detail-label">{i18n(I18nKey.placesTripDetail)}</p>
              <h2 class="trip-detail-title dark:text-neutral-100">{trip.title}</h2>
              <time class="trip-detail-date dark:text-neutral-400" datetime={trip.date.toISOString().slice(0, 10)}>
                {formatTripDateRange(trip)}
              </time>
              <div class="trip-card-tags">
                {trip.category && <span class="place-source-tag dark:text-neutral-400">{trip.category}</span>}
                {trip.tags.map((tag) => <span class="place-source-tag dark:text-neutral-400">{tag}</span>)}
              </div>
              {trip.description && <p class="trip-detail-description dark:text-neutral-100">{trip.description}</p>}

              <h3 class="trip-detail-locations-title dark:text-neutral-100">{i18n(I18nKey.placesLocations)}</h3>
              <div class="trip-location-list">
                {trip.locations.map((location, locationIndex) => {
                  const locationImages = location.images.filter(Boolean);
                  const area = [location.province, location.city, location.district]
                    .filter((value, index, values) => value && values.indexOf(value) === index)
                    .join(" · ");
                  return (
                    <article
                      class="trip-location-card"
                      data-location-card
                      data-trip-id={trip.id}
                      data-location-index={locationIndex}
                      role="button"
                      tabindex="0"
                      aria-expanded="false"
                    >
                      <div class="trip-location-summary">
                        {locationImages[0] && (
                          <button
                            type="button"
                            class="trip-location-cover"
                            data-location-image="0"
                            aria-label={`${location.name} 1`}
                          >
                            <img src={locationImages[0]} alt="" loading="lazy" />
                          </button>
                        )}
                        <div class="trip-location-main">
                          <h4 class="trip-location-name dark:text-neutral-100">{location.name}</h4>
                          <p
                            class="trip-location-area dark:text-neutral-400"
                            data-location-area
                            data-location-date={location.date?.toISOString().slice(0, 10) || ""}
                          >
                            {area}{location.date ? ` · ${location.date.toISOString().slice(0, 10)}` : ""}
                          </p>
                          {location.description && (
                            <p class="trip-location-description-summary dark:text-neutral-100">{location.description}</p>
                          )}
                          <p class="trip-location-photo-count dark:text-neutral-400">
                            {locationImages.length} {i18n(I18nKey.galleryPhotos)}
                          </p>
                        </div>
                        <button type="button" class="trip-location-map" data-location-map>
                          <Icon name="material-symbols:location-on" is:inline />
                          {i18n(I18nKey.placesViewOnMap)}
                        </button>
                      </div>
                      <div class="trip-location-expanded" hidden>
                        {location.description && (
                          <p class="trip-location-description dark:text-neutral-100">{location.description}</p>
                        )}
                        {locationImages.length > 0 && (
                          <div class="trip-location-thumbnails">
                            {locationImages.map((src, imageIndex) => (
                              <button
                                type="button"
                                class="trip-location-thumbnail"
                                data-location-image={imageIndex}
                                aria-label={`${location.name} ${imageIndex + 1}`}
                              >
                                <img src={src} alt="" loading="lazy" />
                              </button>
                            ))}
                          </div>
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>
            </article>
        ))}
      </div>
    </div>
  </div>

<script
  slot="head"
  is:inline
  define:vars={{
    clientSortedTrips,
    placesI18n,
    ownerLocation,
    amapKey,
    amapSecurityJsCode,
    reverseGeocode,
    areaHighlightEnabled,
    districtQueryInterval,
    placesDevMode,
  }}
>
(function () {
  var map = null;
  /** @type {any} */
  var browserWindow = window;
  var cluster = null;
  var markers = [];
  var ownerMarker = null;
  var infoWindow = null;
  var ignorePopupCloseState = false;
  var areaPolygons = [];
  var areaRenderToken = 0;
  var clusterEnabled = true;
  var activeFilter = "all";
  var mapMode = "overview";
  var selectedCityKey = null;
  var selectedTripId = null;
  var selectedLocationKey = null;
  var tripListScrollY = 0;
  var loadingEl = document.getElementById("places-map-loading");
  var uiBound = false;
  var initToken = 0;
  var amapLoadPromise = null;
  var reverseGeocodeCache = {};
  var reverseGeocoder = null;
  var reverseGeocodeHydrationPromise = null;
  var districtBoundaryCache = {};
  var districtBoundaryQueue = Promise.resolve();
  var districtBoundaryRequestId = 0;
  var lastDistrictRequestAt = 0;

  // 旅行详情中的地点点击 → 滚动到地图并定位对应 Marker
  var pendingTarget = null;
  function handleInfoWindowClose() {
    setPlacesPopupOpen(false);
    if (ignorePopupCloseState) {
      ignorePopupCloseState = false;
      return;
    }
    if (mapMode === "location" && selectedTripId) {
      setPlacesState({ mode: "trip", tripId: selectedTripId, locationKey: null }, {
        keepPopup: true,
        openLocation: true,
      });
    }
  }

  function closeInfoWindowForRender() {
    if (!infoWindow) return;
    ignorePopupCloseState = true;
    infoWindow.close();
    window.setTimeout(function () {
      ignorePopupCloseState = false;
    }, 0);
  }

  function jumpToPlace(place, lng, lat) {
    if (!map || !place) return false;
    var AMap = browserWindow.AMap;
    if (!AMap) return false;
    var pos = [lng, lat];
    // 先 resize，确保地图容器尺寸正确（首次从屏幕外滚入时尺寸可能为 0）
    try { map.resize(); } catch (e) {}
    // 等 resize 生效后再定位，否则居中会偏移
    setTimeout(function () {
      if (!map) return;
      try { map.resize(); } catch (e) {}
      var cur = map.getZoom() || 5;
      var targetZoom = Math.max(cur, 16);
      if (cur < 16) {
        map.setZoomAndCenter(targetZoom, pos);
      } else {
        map.panTo(pos);
      }
      if (!infoWindow) {
        infoWindow = new AMap.InfoWindow({
          isCustom: true,
          autoMove: false,
          offset: new AMap.Pixel(0, 14),
        });
        infoWindow.on("close", handleInfoWindowClose);
      }
      infoWindow.setContent(buildPopupHtml(place));
      setPlacesPopupOpen(true);
      setTimeout(function () {
        if (!map) return;
        infoWindow.open(map, pos);
        // 弹窗在 marker 上方，向下平移地图让 marker 上移，确保弹窗完整显示
        setTimeout(function () {
          try { map.panBy(0, 140); } catch (err) {}
        }, 300);
      }, cur < 16 ? 500 : 100);
    }, 150);
    return true;
  }
  function waitForMapAndJump() {
    if (!pendingTarget) return;
    if (jumpToPlace(pendingTarget.place, pendingTarget.lng, pendingTarget.lat)) {
      pendingTarget = null;
    } else {
      setTimeout(waitForMapAndJump, 100);
    }
  }
  function findTrip(tripId) {
    return clientSortedTrips.find(function (trip) {
      return trip.id === tripId;
    });
  }

  function scrollToMap() {
    var mapShell = document.querySelector(".places-map-shell");
    if (mapShell) {
      var rect = mapShell.getBoundingClientRect();
      var top = rect.top + window.scrollY - 180;
      window.scrollTo({ top: Math.max(0, top), behavior: "smooth" });
    }
  }

  function normalizedAdminValue(value) {
    return typeof value === "string" ? value.trim() : "";
  }

  function hasAdministrativeInfo(location) {
    return !!(
      normalizedAdminValue(location.province) ||
      normalizedAdminValue(location.city) ||
      normalizedAdminValue(location.district)
    );
  }

  function coordinateCacheKey(location) {
    var lng = Number(location.rawLng == null ? location.lng : location.rawLng);
    var lat = Number(location.rawLat == null ? location.lat : location.rawLat);
    return lng.toFixed(6) + "|" + lat.toFixed(6);
  }

  function cityKeyFromLocation(location) {
    var province = normalizedAdminValue(location.province);
    var city = normalizedAdminValue(location.city);
    if (!city) return null;
    return [province, city].join("|");
  }

  function locationAreaText(location) {
    return [location.province, location.city, location.district]
      .map(normalizedAdminValue)
      .filter(function (value, index, values) {
        return value && values.indexOf(value) === index;
      })
      .join(" · ");
  }

  function syncLocationAdministrativeLabels() {
    document.querySelectorAll("[data-location-card]").forEach(function (card) {
      var trip = findTrip(card.getAttribute("data-trip-id") || "");
      var index = Number(card.getAttribute("data-location-index") || 0);
      var location = trip && trip.locations[index];
      var label = card.querySelector("[data-location-area]");
      if (!location || !label) return;
      var area = locationAreaText(location);
      var date = label.getAttribute("data-location-date") || "";
      label.textContent = [area, date].filter(Boolean).join(" · ");
    });
  }

  function reverseGeocodeLocation(AMap, location) {
    if (!reverseGeocode || hasAdministrativeInfo(location)) {
      return Promise.resolve(false);
    }
    var key = coordinateCacheKey(location);
    if (!reverseGeocodeCache[key]) {
      reverseGeocodeCache[key] = new Promise(function (resolve) {
        AMap.plugin(["AMap.Geocoder"], function () {
          if (!reverseGeocoder) reverseGeocoder = new AMap.Geocoder();
          var lng = Number(location.rawLng == null ? location.lng : location.rawLng);
          var lat = Number(location.rawLat == null ? location.lat : location.rawLat);
          reverseGeocoder.getAddress([lng, lat], function (status, result) {
            var component =
              status === "complete" && result && result.regeocode
                ? result.regeocode.addressComponent || {}
                : {};
            var province = normalizedAdminValue(component.province);
            var city = normalizedAdminValue(component.city);
            var district = normalizedAdminValue(component.district);
            if (!city && /市$/.test(province)) city = province;
            resolve(
              province || city || district
                ? { province: province, city: city, district: district }
                : null,
            );
          });
        });
      });
    }
    return reverseGeocodeCache[key].then(function (administrative) {
      if (!administrative || hasAdministrativeInfo(location)) return false;
      location.province = administrative.province;
      location.city = administrative.city;
      location.district = administrative.district;
      return true;
    });
  }

  function hydrateMissingAdministrativeInfo(AMap) {
    if (reverseGeocodeHydrationPromise) return reverseGeocodeHydrationPromise;
    var tasks = [];
    clientSortedTrips.forEach(function (trip) {
      (trip.locations || []).forEach(function (location) {
        if (!hasAdministrativeInfo(location)) {
          tasks.push(reverseGeocodeLocation(AMap, location));
        }
      });
    });
    if (!tasks.length) {
      reverseGeocodeHydrationPromise = Promise.resolve(false);
      return reverseGeocodeHydrationPromise;
    }
    reverseGeocodeHydrationPromise = Promise.all(tasks).then(function (results) {
      return results.some(Boolean);
    });
    return reverseGeocodeHydrationPromise;
  }

  function locationKey(tripId, locationIndex) {
    return String(tripId) + "::" + String(locationIndex);
  }

  function cardLocationKey(card) {
    return locationKey(
      card.getAttribute("data-trip-id") || "",
      Number(card.getAttribute("data-location-index") || 0),
    );
  }

  function buildOverviewData() {
    var groups = {};
    var unassignedLocations = [];
    clientSortedTrips.filter(matchesFilter).forEach(function (trip) {
      (trip.locations || []).forEach(function (location, locationIndex) {
        if (!isFinite(location.lng) || !isFinite(location.lat)) return;
        var point = pointFromLocation(trip, location, locationIndex);
        var key = cityKeyFromLocation(location);
        if (!key) {
          unassignedLocations.push(point);
          return;
        }
        if (!groups[key]) {
          groups[key] = {
            key: key,
            province: location.province || "",
            city: location.city || "",
            name: location.city,
            tripIds: [],
            points: [],
          };
        }
        if (groups[key].tripIds.indexOf(trip.id) < 0) {
          groups[key].tripIds.push(trip.id);
        }
        groups[key].points.push(point);
      });
    });
    var resolvedGroups = Object.keys(groups).map(function (key) {
      var group = groups[key];
      var lngTotal = 0;
      var latTotal = 0;
      group.points.forEach(function (point) {
        lngTotal += point.lng;
        latTotal += point.lat;
      });
      group.lng = lngTotal / group.points.length;
      group.lat = latTotal / group.points.length;
      return group;
    });
    return {
      cityGroups: resolvedGroups,
      unassignedLocations: unassignedLocations,
    };
  }

  function cityGroups() {
    return buildOverviewData().cityGroups;
  }

  function findCityGroup(key) {
    return cityGroups().find(function (group) {
      return group.key === key;
    });
  }

  function findPointByLocationKey(key) {
    var found = null;
    clientSortedTrips.some(function (trip) {
      return (trip.locations || []).some(function (location, locationIndex) {
        if (locationKey(trip.id, locationIndex) !== key) return false;
        found = pointFromLocation(trip, location, locationIndex);
        return true;
      });
    });
    return found;
  }

  function setCardExpanded(card, expanded) {
    if (!card) return;
    card.setAttribute("aria-expanded", String(expanded));
    card.classList.toggle("is-expanded", expanded);
    var content = card.querySelector(".trip-location-expanded");
    if (content) content.hidden = !expanded;
  }

  function renderContentForState(options) {
    options = options || {};
    syncLocationAdministrativeLabels();
    var listView = document.getElementById("places-trip-list-view");
    var detailView = document.getElementById("places-trip-detail-view");
    var showDetail = mapMode === "trip" || mapMode === "location";
    if (listView) listView.hidden = showDetail;
    if (detailView) detailView.hidden = !showDetail;
    document.querySelectorAll("[data-trip-detail-id]").forEach(function (detail) {
      detail.hidden = detail.getAttribute("data-trip-detail-id") !== selectedTripId;
    });

    var cityContext = document.getElementById("places-city-context");
    var cityName = document.getElementById("places-city-name");
    var cityGroup = selectedCityKey ? findCityGroup(selectedCityKey) : null;
    if (cityContext) cityContext.hidden = mapMode !== "city";
    if (cityName) cityName.textContent = cityGroup ? cityGroup.name : "";

    document.querySelectorAll("[data-trip-detail-id]").forEach(function (detail) {
      if (detail.getAttribute("data-trip-detail-id") !== selectedTripId) return;
      var canReturnToCity = !!(cityGroup && cityGroup.tripIds.length > 1);
      var backLabel = detail.querySelector("[data-trip-back-label]");
      var overviewButton = detail.querySelector("[data-trip-overview]");
      if (backLabel) {
        backLabel.textContent = canReturnToCity ? cityGroup.name : "";
        if (!canReturnToCity) {
          backLabel.textContent = overviewButton
            ? overviewButton.textContent.trim()
            : "";
        }
      }
      if (overviewButton) overviewButton.hidden = !canReturnToCity;
    });

    document.querySelectorAll("[data-location-card]").forEach(function (card) {
      var key = cardLocationKey(card);
      var selected = key === selectedLocationKey;
      card.classList.toggle("is-selected", selected);
      if (options.openLocation) setCardExpanded(card, selected);
    });

    syncListFilter();
    if (options.scrollLocation && selectedLocationKey) {
      window.requestAnimationFrame(function () {
        var target = Array.from(document.querySelectorAll("[data-location-card]")).find(
          function (card) {
            return cardLocationKey(card) === selectedLocationKey;
          },
        );
        if (target) target.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    }
  }

  function setPlacesState(next, options) {
    options = options || {};
    if (options.captureScroll) tripListScrollY = window.scrollY;
    mapMode = next.mode || mapMode;
    selectedCityKey = Object.prototype.hasOwnProperty.call(next, "cityKey")
      ? next.cityKey
      : selectedCityKey;
    selectedTripId = Object.prototype.hasOwnProperty.call(next, "tripId")
      ? next.tripId
      : selectedTripId;
    selectedLocationKey = Object.prototype.hasOwnProperty.call(next, "locationKey")
      ? next.locationKey
      : selectedLocationKey;

    if (mapMode !== "location") pendingTarget = null;
    renderContentForState(options);
    if (infoWindow && !options.keepPopup) closeInfoWindowForRender();
    if (!options.skipMap) {
      if (map && browserWindow.AMap) refreshMap(browserWindow.AMap);
      else if (document.getElementById("places-amap")) init();
    }

    if (mapMode === "location" && selectedLocationKey) {
      var point = findPointByLocationKey(selectedLocationKey);
      if (point) {
        pendingTarget = { place: point, lng: point.lng, lat: point.lat };
        waitForMapAndJump();
      }
    }
  }

  function selectCity(cityKey) {
    var group = findCityGroup(cityKey);
    if (!group || !group.tripIds.length) return;
    if (group.tripIds.length === 1) {
      setPlacesState(
        { mode: "trip", cityKey: cityKey, tripId: group.tripIds[0], locationKey: null },
        { captureScroll: true, openLocation: true },
      );
      return;
    }
    setPlacesState(
      { mode: "city", cityKey: cityKey, tripId: null, locationKey: null },
      { captureScroll: true, openLocation: true },
    );
  }

  function selectTrip(tripId) {
    var trip = findTrip(tripId);
    if (!trip) return;
    setPlacesState(
      {
        mode: "trip",
        cityKey: mapMode === "city" ? selectedCityKey : null,
        tripId: trip.id,
        locationKey: null,
      },
      { captureScroll: true, openLocation: true },
    );
  }

  function showTripList() {
    setPlacesState(
      { mode: "overview", cityKey: null, tripId: null, locationKey: null },
      { openLocation: true },
    );
    window.requestAnimationFrame(function () {
      window.scrollTo({ top: tripListScrollY, behavior: "auto" });
    });
  }

  function toggleLocationCard(card) {
    if (!card) return;
    var expanded = card.getAttribute("aria-expanded") === "true";
    var key = cardLocationKey(card);
    var leavingLocationMode = mapMode === "location";
    setPlacesState(
      {
        mode: leavingLocationMode ? "trip" : mapMode,
        tripId: selectedTripId,
        locationKey: expanded ? null : key,
      },
      {
        openLocation: true,
        skipMap: !leavingLocationMode,
      },
    );
  }

  function openLightbox(images, index) {
	if (!images || !images.length) return;
	document.dispatchEvent(
	  new CustomEvent("firefly:gallery-open", {
		detail: { images: images.slice(), index: Number(index) || 0 },
	  }),
	);
  }

  // 使用 document 事件委托，兼容 Swup / Astro 页面切换。
  document.addEventListener("click", function (e) {
    var overviewButton = e.target.closest("[data-trip-overview], [data-city-overview]");
    if (overviewButton) {
      showTripList();
      return;
    }

    var back = e.target.closest("[data-trip-back]");
    if (back) {
      var cityGroup = selectedCityKey ? findCityGroup(selectedCityKey) : null;
      if (cityGroup && cityGroup.tripIds.length > 1) {
        setPlacesState({
          mode: "city",
          cityKey: selectedCityKey,
          tripId: null,
          locationKey: null,
        });
      } else {
        showTripList();
      }
      return;
    }

	var imageButton = e.target.closest("[data-location-image]");
	if (imageButton) {
	  e.preventDefault();
	  e.stopPropagation();
	  var imageCard = imageButton.closest("[data-location-card]");
	  var imageTrip = imageCard && findTrip(imageCard.getAttribute("data-trip-id") || "");
	  var imageLocationIndex = imageCard
		? Number(imageCard.getAttribute("data-location-index"))
		: -1;
	  var imageLocation = imageTrip && imageTrip.locations[imageLocationIndex];
	  if (imageLocation) {
		openLightbox(
		  imageLocation.images || [],
		  Number(imageButton.getAttribute("data-location-image")) || 0,
		);
	  }
	  return;
	}

    var locationButton = e.target.closest("[data-location-map]");
    if (locationButton) {
	  e.preventDefault();
	  e.stopPropagation();
	  var locationCard = locationButton.closest("[data-location-card]");
	  var trip = locationCard && findTrip(locationCard.getAttribute("data-trip-id") || "");
	  var locationIndex = locationCard
		? Number(locationCard.getAttribute("data-location-index"))
		: -1;
      var location = trip && trip.locations[locationIndex];
      if (!trip || !location) return;
      setPlacesState(
        {
          mode: "location",
          cityKey: selectedCityKey,
          tripId: trip.id,
          locationKey: locationKey(trip.id, locationIndex),
        },
        { openLocation: true },
      );
      scrollToMap();
      return;
    }

	var locationCard = e.target.closest("[data-location-card]");
	if (locationCard) {
	  toggleLocationCard(locationCard);
	  return;
	}

    var card = e.target.closest(".trip-card");
    if (!card) return;
    selectTrip(card.getAttribute("data-trip-id") || "");
  });

  document.addEventListener("keydown", function (e) {
    if (e.key !== "Enter" && e.key !== " ") return;
	if (e.target.closest("[data-location-map], [data-location-image]")) return;
	var locationCard = e.target.closest("[data-location-card]");
	if (locationCard) {
	  e.preventDefault();
	  toggleLocationCard(locationCard);
	  return;
	}
    var card = e.target.closest(".trip-card");
    if (!card) return;
    e.preventDefault();
    selectTrip(card.getAttribute("data-trip-id") || "");
  });

  function hideLoading() {
    if (loadingEl) loadingEl.classList.add("is-hidden");
  }

  function escapeHtml(str) {
    return String(str == null ? "" : str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function showMessage(text) {
    hideLoading();
    var el = document.getElementById("places-amap");
    if (!el) return;
    el.innerHTML =
      '<div class="places-amap-fallback">' +
      String(text || placesI18n.mapLoadFailed) +
      "</div>";
  }

  function matchesFilter(trip) {
    if (activeFilter === "all") return true;
    if (activeFilter.indexOf("year:") === 0) {
      var y = Number(activeFilter.slice(5));
      return (trip.years || []).indexOf(y) >= 0;
    }
    if (activeFilter.indexOf("cat:") === 0) {
      return trip.category === activeFilter.slice(4);
    }
    return true;
  }

  function filteredTrips() {
    return clientSortedTrips.filter(function (trip) {
      if (!matchesFilter(trip)) return false;
      if (mapMode === "overview") return true;
      if (mapMode === "city") {
        return (trip.locations || []).some(function (location) {
          return cityKeyFromLocation(location) === selectedCityKey;
        });
      }
      return trip.id === selectedTripId;
    });
  }

  function pointFromLocation(trip, location, locationIndex) {
    return Object.assign({}, trip, {
      tripId: trip.id,
      location: location,
      locationKey: locationKey(trip.id, locationIndex),
      name: location.name,
      province: location.province,
      city: location.city,
	  district: location.district || "",
      lng: location.lng,
      lat: location.lat,
      exact: location.exact,
    });
  }

  function filteredPoints() {
    var points = [];
    filteredTrips().forEach(function (trip) {
      (trip.locations || []).forEach(function (location, locationIndex) {
        if (!isFinite(location.lng) || !isFinite(location.lat)) return;
        if (
          mapMode === "city" &&
          cityKeyFromLocation(location) !== selectedCityKey
        ) {
          return;
        }
        points.push(pointFromLocation(trip, location, locationIndex));
      });
    });
    return points;
  }

  function syncListFilter() {
    var cards = document.querySelectorAll("#places-list .place-card");
    cards.forEach(function (card) {
      var years = (card.getAttribute("data-years") || "")
        .split(",")
        .filter(Boolean)
        .map(Number);
      var cat = card.getAttribute("data-category") || "";
      var show = true;
      if (activeFilter.indexOf("year:") === 0) {
        show = years.indexOf(Number(activeFilter.slice(5))) >= 0;
      } else if (activeFilter.indexOf("cat:") === 0) {
        show = cat === activeFilter.slice(4);
      }
      if (show && mapMode === "city") {
        var trip = findTrip(card.getAttribute("data-trip-id") || "");
        show = !!(
          trip &&
          (trip.locations || []).some(function (location) {
            return cityKeyFromLocation(location) === selectedCityKey;
          })
        );
      }
      card.classList.toggle("is-hidden", !show);
    });
  }

  function clearMarkers() {
    if (infoWindow) {
      closeInfoWindowForRender();
      setPlacesPopupOpen(false);
    }
    if (cluster) {
      cluster.setMap(null);
      cluster = null;
    }
    markers.forEach(function (m) {
      m.setMap(null);
    });
    markers = [];
    if (ownerMarker) {
      ownerMarker.setMap(null);
      ownerMarker = null;
    }
  }

  function invalidateAreaRender() {
    areaRenderToken += 1;
	return areaRenderToken;
  }

  function removeAreaPolygons() {
    areaPolygons.forEach(function (p) {
      map && map.remove(p);
    });
    areaPolygons = [];
  }

  function clearAreas() {
	invalidateAreaRender();
	removeAreaPolygons();
  }

  function buildPopupHtml(place) {
    var title = escapeHtml(place.name || "");
    var dateText =
      escapeHtml(place.date) +
      (place.endDate ? " — " + escapeHtml(place.endDate) : "");
    var tags = [];
	var area = [place.province, place.city, place.district]
	  .filter(function (value, index, values) {
		return value && values.indexOf(value) === index;
	  })
	  .join(" · ");
    if (area) tags.push(area);
    if (place.category) tags.push(place.category);
	(place.tags || []).forEach(function (tag) {
	  tags.push(tag);
	});
	if (place.location && place.location.date) {
	  tags.push(place.location.date);
	}
    (place.years || []).forEach(function (y) {
      tags.push(String(y));
    });
    var tagsHtml = tags
      .map(function (t) {
        return '<span class="places-popup-tag">' + escapeHtml(t) + "</span>";
      })
      .join("");

	var images =
	  (place.location && place.location.images
		? place.location.images
		: []
	  ).filter(Boolean);
    var galleryHtml = "";
    if (images.length) {
      var imgs = images
        .map(function (src, i) {
          return (
            '<img class="places-gallery-img' +
            (i === 0 ? " is-active" : "") +
            '" src="' +
            escapeHtml(src) +
            '" alt="" loading="lazy" data-idx="' +
            i +
            '" />'
          );
        })
        .join("");
      var navHtml =
        images.length > 1
          ? '<button type="button" class="places-gallery-nav places-gallery-prev" aria-label="prev"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M15.4 18.4 9 12l6.4-6.4 1.4 1.4L11.8 12l5 5z"/></svg></button>' +
            '<button type="button" class="places-gallery-nav places-gallery-next" aria-label="next"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="m9 18.4-1.4-1.4 5-5-5-5L9 5.6 15.4 12z"/></svg></button>' +
            '<div class="places-gallery-dots">' +
            images
              .map(function (_, i) {
                return (
                  '<span class="places-gallery-dot' +
                  (i === 0 ? " is-active" : "") +
                  '" data-idx="' +
                  i +
                  '"></span>'
                );
              })
              .join("") +
            "</div>"
          : "";
      galleryHtml =
        '<div class="places-gallery" data-total="' +
        images.length +
        '" data-index="0">' +
        navHtml +
        '<div class="places-gallery-viewport">' +
        imgs +
        "</div></div>";
    }

    var linkHtml = place.link
      ? '<a class="places-popup-link" href="' +
        escapeHtml(place.link) +
        '" target="_blank" rel="noopener noreferrer">游记</a>'
      : "";

    return (
      '<div class="places-popup">' +
      '<div class="places-popup-head dark:text-neutral-100">' +
      "<strong>" +
      title +
      "</strong>" +
      '<button type="button" class="places-popup-close" aria-label="close">×</button>' +
      "</div>" +
      '<div class="places-popup-date dark:text-neutral-100">' +
      dateText +
      "</div>" +
      (tagsHtml
        ? '<div class="places-popup-tags">' + tagsHtml + "</div>"
        : "") +
	  (place.location && place.location.description
		? '<p class="places-popup-exp dark:text-neutral-100">' +
		  escapeHtml(place.location.description) +
		  "</p>"
		: "") +
	  (place.description &&
	  (!place.location || place.description !== place.location.description)
		? '<p class="places-popup-exp dark:text-neutral-100">' +
		  escapeHtml(place.description) +
          "</p>"
        : "") +
      linkHtml +
      galleryHtml +
      "</div>"
    );
  }

  function setPlacesPopupOpen(open) {
    var frame = document.querySelector(".places-map-frame");
    if (!frame) return;
    frame.classList.toggle("is-popup-open", !!open);
  }

  var cityTripPalette = [
    "#0ea5e9",
    "#f97316",
    "#8b5cf6",
    "#22c55e",
    "#ec4899",
    "#eab308",
    "#06b6d4",
    "#ef4444",
  ];

  function cityTripColors() {
    var colors = {};
    filteredTrips().forEach(function (trip, index) {
      colors[trip.id] = cityTripPalette[index % cityTripPalette.length];
    });
    return colors;
  }

  function pinColor(place) {
    if (mapMode === "location" && place.locationKey === selectedLocationKey) {
      return "#f43f5e";
    }
    if (mapMode === "city") {
      return cityTripColors()[place.tripId] || "#0ea5e9";
    }
    return "#12d6a8";
  }

  function buildLocationMarkerHtml(place) {
    var color = pinColor(place);
    var title = escapeHtml(place.name || "");
    return (
      '<div class="places-pin' +
      (mapMode === "location" && place.locationKey === selectedLocationKey
        ? " is-active"
        : "") +
      '" style="--pin:' +
      color +
      '" title="' +
      title +
      '"></div>'
    );
  }

  function pinOffset(AMap, place) {
    var active =
      mapMode === "location" && place && place.locationKey === selectedLocationKey;
    return new AMap.Pixel(active ? -15 : -12, active ? -15 : -12);
  }

  function enterLocationState(place, options) {
    if (!place) return;
    setPlacesState(
      {
        mode: "location",
        cityKey: selectedCityKey,
        tripId: place.tripId,
        locationKey: place.locationKey,
      },
      {
        openLocation: true,
        scrollLocation: !!(options && options.scrollLocation),
      },
    );
  }

  function buildLocationMarker(AMap, place) {
    var wrap = document.createElement("div");
    wrap.innerHTML = buildLocationMarkerHtml(place);
    var content = wrap.firstElementChild || wrap;
    bindMarkerActivate(content, function () {
      enterLocationState(place);
    });
    var marker = new AMap.Marker({
      position: [place.lng, place.lat],
      title: place.name || "",
      content: content,
      offset: pinOffset(AMap, place),
      extData: place,
    });
    marker.on("click", function () {
      enterLocationState(place);
    });
    return marker;
  }

  function buildCityMarker(AMap, group) {
    var content = document.createElement("div");
    content.className = "places-city-marker";
    content.innerHTML =
      '<span class="places-city-marker-name">' +
      escapeHtml(group.name) +
      '</span><strong class="places-city-marker-count">' +
      group.tripIds.length +
      "</strong>";
    bindMarkerActivate(content, function () {
      selectCity(group.key);
    });
    var marker = new AMap.Marker({
      position: [group.lng, group.lat],
      title: group.name,
      content: content,
      offset: new AMap.Pixel(-36, -20),
      extData: group,
      zIndex: 110,
    });
    marker.on("click", function () {
      selectCity(group.key);
    });
    return marker;
  }

  function readLngLat(item) {
    if (!item) return null;
    if (item.lnglat) {
      if (Array.isArray(item.lnglat) && item.lnglat.length >= 2) {
        var a0 = Number(item.lnglat[0]);
        var a1 = Number(item.lnglat[1]);
        if (isFinite(a0) && isFinite(a1)) return [a0, a1];
      }
      if (item.lnglat.lng != null && item.lnglat.lat != null) {
        var b0 = Number(item.lnglat.lng);
        var b1 = Number(item.lnglat.lat);
        if (isFinite(b0) && isFinite(b1)) return [b0, b1];
      }
      if (typeof item.lnglat.getLng === "function") {
        return [item.lnglat.getLng(), item.lnglat.getLat()];
      }
    }
    if (typeof item.getPosition === "function") {
      var p = item.getPosition();
      if (p) return [p.getLng(), p.getLat()];
    }
    return null;
  }

  /** 点击聚合点：只框住「当前这一簇」的点并继续放大拆分 */
  var lastClusterZoomAt = 0;

  /** 桌面 click + 移动端 touchend（自定义 content 时手机常吃不到 click） */
  function bindMarkerActivate(el, handler) {
    if (!el || typeof handler !== "function") return;
    var touching = false;
    var moved = false;
    var startX = 0;
    var startY = 0;
    var MOVE_PX = 12;

    el.addEventListener("click", function (ev) {
      // touchend 已处理过则忽略合成 click，避免双触发
      if (touching) return;
      ev.preventDefault();
      ev.stopPropagation();
      handler();
    });

    el.addEventListener(
      "touchstart",
      function (ev) {
        touching = true;
        moved = false;
        var t = ev.touches && ev.touches[0];
        if (!t) return;
        startX = t.clientX;
        startY = t.clientY;
      },
      { passive: true },
    );

    el.addEventListener(
      "touchmove",
      function (ev) {
        var t = ev.touches && ev.touches[0];
        if (!t) return;
        if (
          Math.abs(t.clientX - startX) > MOVE_PX ||
          Math.abs(t.clientY - startY) > MOVE_PX
        ) {
          moved = true;
        }
      },
      { passive: true },
    );

    el.addEventListener(
      "touchend",
      function (ev) {
        if (moved) {
          touching = false;
          return;
        }
        ev.preventDefault();
        ev.stopPropagation();
        handler();
        // 短暂锁住，吃掉随后的合成 click
        window.setTimeout(function () {
          touching = false;
        }, 350);
      },
      { passive: false },
    );

    el.addEventListener(
      "touchcancel",
      function () {
        touching = false;
        moved = false;
      },
      { passive: true },
    );
  }

  function zoomToCluster(event) {
    if (!map) return;
    var now = Date.now();
    if (now - lastClusterZoomAt < 200) return;
    lastClusterZoomAt = now;

    try {
      var data = (event && event.clusterData) || [];
      var coordMap = {};

      function addCoord(lng, lat) {
        lng = Number(lng);
        lat = Number(lat);
        if (!isFinite(lng) || !isFinite(lat)) return;
        var key = lng.toFixed(5) + "," + lat.toFixed(5);
        coordMap[key] = [lng, lat];
      }

      function centerFromEvent() {
        if (!event || !event.lnglat) return null;
        if (Array.isArray(event.lnglat)) {
          return [Number(event.lnglat[0]), Number(event.lnglat[1])];
        }
        if (typeof event.lnglat.getLng === "function") {
          return [event.lnglat.getLng(), event.lnglat.getLat()];
        }
        if (event.lnglat.lng != null && event.lnglat.lat != null) {
          return [Number(event.lnglat.lng), Number(event.lnglat.lat)];
        }
        return null;
      }

      // 只用当前簇里的点，不要再补同城（否则 8 会把已拆开的灞河又算进去，无法继续拆）
      data.forEach(function (item) {
        var ll = readLngLat(item);
        if (ll) {
          addCoord(ll[0], ll[1]);
          return;
        }
        // 兜底：从 place 上取
        if (item && item.place && item.place.lng != null && item.place.lat != null) {
          addCoord(item.place.lng, item.place.lat);
        }
      });

      var coords = [];
      for (var key in coordMap) {
        if (Object.prototype.hasOwnProperty.call(coordMap, key)) {
          coords.push(coordMap[key]);
        }
      }

      var center = centerFromEvent();
      var curZoom = map.getZoom() || 5;

      if (!coords.length && center) {
        map.setZoomAndCenter(Math.min(curZoom + 3, 18), center);
        return;
      }
      if (!coords.length) return;

      if (coords.length === 1) {
        var one = data[0];
        var place = (one && one.place) || null;
        if (place) enterLocationState(place);
        else map.setZoomAndCenter(Math.max(curZoom, 16), coords[0]);
        return;
      }

      var minLng = Infinity;
      var maxLng = -Infinity;
      var minLat = Infinity;
      var maxLat = -Infinity;
      coords.forEach(function (c) {
        minLng = Math.min(minLng, c[0]);
        maxLng = Math.max(maxLng, c[0]);
        minLat = Math.min(minLat, c[1]);
        maxLat = Math.max(maxLat, c[1]);
      });
      var mid = [(minLng + maxLng) / 2, (minLat + maxLat) / 2];
      var span = Math.max(maxLng - minLng, maxLat - minLat, 0.008);
      var spanZoom = 6;
      if (span < 0.015) spanZoom = 15;
      else if (span < 0.03) spanZoom = 14;
      else if (span < 0.06) spanZoom = 13;
      else if (span < 0.12) spanZoom = 12;
      else if (span < 0.3) spanZoom = 11;
      else if (span < 0.8) spanZoom = 10;
      else if (span < 2) spanZoom = 8;
      else if (span < 5) spanZoom = 7;

      // 每次点击至少 +2 级，保证 9→8+1 之后再点 8 还能继续拆开
      var zoom = Math.max(spanZoom, curZoom + 2);
      zoom = Math.min(zoom, 18);
      map.setZoomAndCenter(zoom, mid);
    } catch (err) {
      console.error("[places-amap] zoomToCluster failed", err);
      try {
        var fb = null;
        if (event && event.lnglat) {
          if (typeof event.lnglat.getLng === "function") {
            fb = [event.lnglat.getLng(), event.lnglat.getLat()];
          } else if (Array.isArray(event.lnglat)) {
            fb = event.lnglat;
          }
        }
        if (fb) {
          map.setZoomAndCenter(Math.min((map.getZoom() || 5) + 3, 18), fb);
        }
      } catch (err2) {
        console.error("[places-amap] zoom fallback failed", err2);
      }
    }
  }

  function clusterDisplayCount(context) {
	if (mapMode === "trip") {
	  return Math.max(1, (context.clusterData || []).length);
	}
	// city 模式下，聚合数字表示当前 cluster 涉及的唯一旅行数。
	var tripIds = {};
    var list = context.clusterData || [];
    list.forEach(function (item) {
      if (!item) return;
      var place = item.place || {};
      var tripKey = String(place.tripId == null ? list.indexOf(item) : place.tripId);
	  tripIds[tripKey] = true;
    });
	return Math.max(1, Object.keys(tripIds).length);
  }

  function buildMarkers(AMap) {
    clearMarkers();

    if (mapMode === "overview") {
      var overviewData = buildOverviewData();
      var groups = overviewData.cityGroups;
      var cityMarkers = groups.map(function (group) {
        return buildCityMarker(AMap, group);
      });
      var unassignedMarkers = overviewData.unassignedLocations.map(function (place) {
        return buildLocationMarker(AMap, place);
      });
      markers = cityMarkers.concat(unassignedMarkers);
      if (markers.length) map.add(markers);

      if (ownerLocation && ownerLocation.lng && ownerLocation.lat) {
        ownerMarker = new AMap.Marker({
          position: [ownerLocation.lng, ownerLocation.lat],
          title: ownerLocation.label || placesI18n.ownerLocation,
          content:
            '<div class="places-owner-dot" title="' +
            escapeHtml(ownerLocation.label || placesI18n.ownerLocation) +
            '"></div>',
          offset: new AMap.Pixel(-8, -8),
          zIndex: 120,
        });
        map.add(ownerMarker);
      }

      var overviewTargets = ownerMarker ? markers.concat([ownerMarker]) : markers;
      if (overviewTargets.length > 1) {
        map.setFitView(overviewTargets, false, [60, 60, 60, 60]);
      } else if (groups.length === 1 && !unassignedMarkers.length) {
        map.setZoomAndCenter(8, [groups[0].lng, groups[0].lat]);
      } else if (overviewData.unassignedLocations.length === 1) {
        var onlyLocation = overviewData.unassignedLocations[0];
        map.setZoomAndCenter(14, [onlyLocation.lng, onlyLocation.lat]);
      } else if (ownerMarker) {
        map.setZoomAndCenter(5, [ownerLocation.lng, ownerLocation.lat]);
      } else {
        map.setZoomAndCenter(5, [108.94, 34.34]);
      }
      return;
    }

    var places = filteredPoints();
    var points = places.map(function (place) {
      return {
        lnglat: [place.lng, place.lat],
        weight: 1,
        place: place,
      };
    });

    if (!points.length) return;
    if (points.length === 1) map.setZoomAndCenter(14, points[0].lnglat);

    if (clusterEnabled && mapMode !== "location" && AMap.MarkerCluster) {
      cluster = new AMap.MarkerCluster(map, points, {
        gridSize: 80,
        maxZoom: 19,
        averageCenter: true,
        renderClusterMarker: function (context) {
          var displayCount = clusterDisplayCount(context);
          var el = document.createElement("div");
          el.className = "places-cluster";
		  el.title =
			mapMode === "trip"
			  ? displayCount + " " + (placesI18n.locations || "")
			  : displayCount + (placesI18n.clusterTrips || " 个旅行");
          el.innerHTML =
            '<span class="places-cluster-count">' + displayCount + "</span>";
          // DOM 激活：桌面用 click，手机用 touchend（自定义 content 时 marker click 不可靠）
          bindMarkerActivate(el, function () {
            zoomToCluster({
              clusterData: context.clusterData,
              lnglat: context.marker.getPosition(),
            });
          });
          context.marker.setContent(el);
          context.marker.setOffset(new AMap.Pixel(-22, -22));
          context.marker.setClickable(true);
          context.marker.off("click");
          context.marker.on("click", function () {
            zoomToCluster({
              clusterData: context.clusterData,
              lnglat: context.marker.getPosition(),
            });
          });
        },
        renderMarker: function (context) {
          var item = (context.data && context.data[0]) || {};
          var place = item.place || {};
          var pinEl = buildLocationMarkerHtml(place);
          if (typeof pinEl === "string") {
            var wrap = document.createElement("div");
            wrap.innerHTML = pinEl;
            pinEl = wrap.firstElementChild || wrap;
          }
          if (pinEl && pinEl.nodeType === 1) {
            bindMarkerActivate(pinEl, function () {
              enterLocationState(place);
            });
          }
          context.marker.setContent(pinEl);
          context.marker.setOffset(pinOffset(AMap, place));
          context.marker.setExtData(place);
          context.marker.setClickable(true);
          context.marker.off("click");
          context.marker.on("click", function () {
            enterLocationState(place);
          });
        },
      });

      cluster.on("click", function (event) {
        var data = event.clusterData || [];
        if (data.length > 1) {
          zoomToCluster(event);
        } else if (data.length === 1 && data[0] && data[0].place) {
          enterLocationState(data[0].place);
        }
      });
    } else {
      markers = places.map(function (place) {
        return buildLocationMarker(AMap, place);
      });
      map.add(markers);
    }

    if (mapMode === "location") return;

    var fitTargets = markers.slice();
    if (!fitTargets.length && cluster) {
      fitTargets = points.map(function (p) {
        return new AMap.Marker({ position: p.lnglat, visible: false });
      });
      map.add(fitTargets);
	  if (points.length > 1) {
		map.setFitView(
		  fitTargets,
		  false,
		  [60, 60, 60, 60],
		);
	  }
      map.remove(fitTargets);
      return;
    }

	if (fitTargets.length > 1) {
      map.setFitView(fitTargets, false, [60, 60, 60, 60]);
    }
  }

  /** 按填写到的最细层级提取行政区：区/县/旗 → 市 → 省。 */
  function visitedCityTargets() {
    var targets = {};
    filteredPoints().forEach(function (p) {
      var province = (p.province || "").trim();
	  var city = (p.city || "").trim();
	  var district = (p.district || "").trim();
      var name = "";
	  var level = "province";

	  if (district) {
		name = district;
		level = "district";
	  } else if (city) {
		name = city;
		level = "city";
	  } else if (province) {
		name = province;
		level = "province";
	  }

	  if (!name) return;
	  var key = [province, city, district, level].join("|");
	  var query = [province, city, district]
		.filter(function (value, index, values) {
		  return value && values.indexOf(value) === index;
		})
		.join("");
	  if (!targets[key]) {
		targets[key] = {
		  key: key,
		  name: name,
		  query: query || name,
		  level: level,
		  province: province,
		  city: city,
		  district: district,
		};
	  }
    });
	return Object.keys(targets).map(function (key) {
	  return targets[key];
	});
  }

  function selectDistrictCandidate(target, result) {
	var candidates =
	  result && Array.isArray(result.districtList) ? result.districtList : [];
	for (var i = 0; i < candidates.length; i += 1) {
	  var candidate = candidates[i];
	  if (!candidate || String(candidate.name || "").trim() !== target.name) continue;
	  var boundaries = Array.isArray(candidate.boundaries)
		? candidate.boundaries.filter(function (ring) {
			return ring && ring.length >= 3;
		  })
		: [];
	  if (boundaries.length) return boundaries;
	}
	return null;
  }

  function waitForDistrictDispatchSlot() {
	return new Promise(function (resolve) {
	  function wait() {
		var now =
		  browserWindow.performance &&
		  typeof browserWindow.performance.now === "function"
			? browserWindow.performance.now()
			: Date.now();
		var elapsed = lastDistrictRequestAt
		  ? now - lastDistrictRequestAt
		  : Infinity;
		var delay = Math.max(0, districtQueryInterval - elapsed);
		if (!delay) {
		  resolve();
		  return;
		}
		window.setTimeout(wait, delay);
	  }
	  wait();
	});
  }

  async function searchDistrict(AMap, target, keyword, diagnostics) {
	await waitForDistrictDispatchSlot();
	return new Promise(function (resolve) {
		var requestId = ++districtBoundaryRequestId;
		var settled = false;
		var dispatchClock =
		  browserWindow.performance &&
		  typeof browserWindow.performance.now === "function"
			? browserWindow.performance.now()
			: Date.now();
		var elapsedSincePreviousRequest = lastDistrictRequestAt
		  ? dispatchClock - lastDistrictRequestAt
		  : null;
		lastDistrictRequestAt = dispatchClock;
		if (placesDevMode) {
		  console.log("[places-amap] district request dispatch", {
			requestId: requestId,
			targetKey: target.key,
			query: keyword,
			timestamp: Date.now(),
			elapsedSincePreviousRequest: elapsedSincePreviousRequest,
			configuredInterval: districtQueryInterval,
		  });
		}
		function finish(status, result) {
		  if (settled) return;
		  settled = true;
		  window.clearTimeout(timeoutId);
		  var candidates =
			result && Array.isArray(result.districtList) ? result.districtList : [];
		  var boundaries =
			status === "complete" ? selectDistrictCandidate(target, result) : null;
		  if (placesDevMode) {
			console.log("[places-amap] boundary request result", {
			  requestId: requestId,
			  renderTokenAtStart: diagnostics.renderToken,
			  currentRenderToken: areaRenderToken,
			  targetKey: target.key,
			  status: status,
			  candidateCount: candidates.length,
			  boundaryCount: boundaries ? boundaries.length : 0,
			});
		  }
		  resolve(boundaries);
		}
		var timeoutId = window.setTimeout(function () {
		  finish("timeout", null);
		}, 10000);
		try {
		  var search = new AMap.DistrictSearch({
			level: target.level,
			extensions: "all",
			subdistrict: 0,
		  });
		  search.search(keyword, function (status, result) {
			finish(status, result);
		  });
		} catch (error) {
		  finish("error", null);
		}
	});
  }

  function resolveDistrictTarget(AMap, target, diagnostics) {
	if (Object.prototype.hasOwnProperty.call(districtBoundaryCache, target.key)) {
	  if (placesDevMode) {
		console.log("[places-amap] boundary cache hit", {
		  renderToken: diagnostics.renderToken,
		  mode: diagnostics.mode,
		  targetKey: target.key,
		  boundaryCount: districtBoundaryCache[target.key].length,
		});
	  }
	  return Promise.resolve(districtBoundaryCache[target.key]);
	}

	var queued = districtBoundaryQueue.then(function () {
	  // 轮到本任务时再查一次缓存，避免队列中同一 target 重复请求。
	  if (Object.prototype.hasOwnProperty.call(districtBoundaryCache, target.key)) {
		if (placesDevMode) {
		  console.log("[places-amap] boundary cache hit", {
			renderToken: diagnostics.renderToken,
			mode: diagnostics.mode,
			targetKey: target.key,
			boundaryCount: districtBoundaryCache[target.key].length,
		  });
		}
		return districtBoundaryCache[target.key];
	  }
	  return searchDistrict(AMap, target, target.query, diagnostics).then(
		function (boundaries) {
		  if (boundaries || target.query === target.name) return boundaries;
		  return searchDistrict(AMap, target, target.name, diagnostics);
		},
		function () {
		  if (target.query === target.name) return null;
		  return searchDistrict(AMap, target, target.name, diagnostics);
		},
	  );
	}).then(function (boundaries) {
	  if (boundaries && boundaries.length) {
		districtBoundaryCache[target.key] = boundaries;
		if (placesDevMode) {
		  console.log("[places-amap] boundary resolved", {
			renderToken: diagnostics.renderToken,
			mode: diagnostics.mode,
			targetKey: target.key,
			boundaryCount: boundaries.length,
		  });
		}
	  } else if (placesDevMode) {
		console.warn("[places-amap] boundary failed", {
		  renderToken: diagnostics.renderToken,
		  mode: diagnostics.mode,
		  targetKey: target.key,
		});
	  }
	  return boundaries;
	});

	// 队列只负责串行化 DistrictSearch，单个失败不会阻断后续任务。
	districtBoundaryQueue = queued.then(
	  function () {},
	  function () {},
	);
	return queued;
  }

  function drawAreas(AMap) {
	if (!areaHighlightEnabled) return;
	var token = invalidateAreaRender();
    var targets = visitedCityTargets();
	var renderMode = mapMode;

    AMap.plugin(["AMap.DistrictSearch"], function () {
	  var tasks = targets.map(function (target) {
		return resolveDistrictTarget(AMap, target, {
		  renderToken: token,
		  mode: renderMode,
		});
	  });
	  Promise.allSettled(tasks).then(function (results) {
		if (token !== areaRenderToken || !map) {
		  if (placesDevMode) {
			console.log("[places-amap] polygons commit skipped", {
			  token: token,
			  currentRenderToken: areaRenderToken,
			  mode: renderMode,
			  targets: targets.map(function (target) {
				return target.key;
			  }),
			});
		  }
		  return;
		}
		var paths = [];
		results.forEach(function (result, index) {
		  var match = result.status === "fulfilled" ? result.value : null;
		  if (!match) {
			if (placesDevMode) {
			  console.warn(
				"[places-amap] district boundary unresolved",
				targets[index],
			  );
			}
			return;
		  }
		  match.forEach(function (ring) {
			paths.push(ring);
		  });
		});
		if (token !== areaRenderToken || !map) return;
		var polygons = paths.map(function (ring) {
		  return new AMap.Polygon({
			path: ring,
			strokeWeight: 1.5,
			strokeColor: "#38bdf8",
			fillColor: "#38bdf8",
			fillOpacity: 0.22,
			bubble: true,
		  });
		});
		if (token !== areaRenderToken || !map) return;
		var oldPolygons = areaPolygons.slice();
		if (polygons.length) map.add(polygons);
		if (oldPolygons.length) map.remove(oldPolygons);
		areaPolygons = polygons;
		if (placesDevMode) {
		  console.log("[places-amap] polygons committed", {
			token: token,
			mode: renderMode,
			targets: targets.map(function (target) {
			  return target.key;
			}),
			polygonCount: polygons.length,
		  });
		}
	  });
    });
  }

  function refreshMap(AMap) {
    buildMarkers(AMap);
	if (areaHighlightEnabled) drawAreas(AMap);
  }

  function setGalleryIndex(gallery, nextIndex) {
    var total = Number(gallery.getAttribute("data-total") || 0);
    if (!total) return;
    var index = ((nextIndex % total) + total) % total;
    gallery.setAttribute("data-index", String(index));
    gallery.querySelectorAll(".places-gallery-img").forEach(function (img, i) {
      img.classList.toggle("is-active", i === index);
    });
    gallery.querySelectorAll(".places-gallery-dot").forEach(function (dot, i) {
      dot.classList.toggle("is-active", i === index);
    });
  }

  function syncClusterToggleState() {
    var clusterToggle = document.getElementById("places-toggle-cluster");
    if (clusterToggle) clusterEnabled = !!clusterToggle.checked;
  }

  function bindUi(AMap) {
	syncClusterToggleState();
    if (uiBound) {
      refreshMap(AMap);
      return;
    }
    uiBound = true;
    var filterBar = document.getElementById("places-map-filters");
    if (filterBar) {
      filterBar.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-filter]");
        if (!btn) return;
        activeFilter = btn.getAttribute("data-filter") || "all";
        filterBar.querySelectorAll(".places-filter-chip").forEach(function (el) {
          el.classList.toggle("is-active", el === btn);
        });
        setPlacesState({
          mode: "overview",
          cityKey: null,
          tripId: null,
          locationKey: null,
        });
      });
    }

    var clusterToggle = document.getElementById("places-toggle-cluster");
    if (clusterToggle) {
      clusterToggle.addEventListener("change", function () {
        clusterEnabled = !!clusterToggle.checked;
        buildMarkers(AMap);
      });
    }

    // 弹窗关闭 / 图片轮播（InfoWindow 内容动态插入）
    document.addEventListener("click", function (e) {
      var closeBtn = e.target.closest(".places-popup-close");
      if (closeBtn && infoWindow) {
        infoWindow.close();
        return;
      }

      // 地图弹窗图片轮播
      var gallery = e.target.closest(".places-gallery");
      if (gallery) {
        var idx = Number(gallery.getAttribute("data-index") || 0);
        if (e.target.closest(".places-gallery-prev")) {
          e.preventDefault();
          e.stopPropagation();
          setGalleryIndex(gallery, idx - 1);
          return;
        }
        if (e.target.closest(".places-gallery-next")) {
          e.preventDefault();
          e.stopPropagation();
          setGalleryIndex(gallery, idx + 1);
          return;
        }
        var dot = e.target.closest(".places-gallery-dot");
        if (dot) {
          e.preventDefault();
          e.stopPropagation();
          setGalleryIndex(gallery, Number(dot.getAttribute("data-idx") || 0));
        }
        return;
      }
    });

    var refreshBtn = document.getElementById("places-ctrl-refresh");
    if (refreshBtn) {
      refreshBtn.addEventListener("click", function () {
        activeFilter = "all";
        if (filterBar) {
          filterBar.querySelectorAll(".places-filter-chip").forEach(function (el) {
            el.classList.toggle(
              "is-active",
              el.getAttribute("data-filter") === "all",
            );
          });
        }
        setPlacesState({
          mode: "overview",
          cityKey: null,
          tripId: null,
          locationKey: null,
        });
        refreshBtn.classList.add("is-spinning");
        window.setTimeout(function () {
          refreshBtn.classList.remove("is-spinning");
        }, 600);
      });
    }

    var zoomInBtn = document.getElementById("places-ctrl-zoom-in");
    if (zoomInBtn) {
      zoomInBtn.addEventListener("click", function () {
        if (map) map.zoomIn();
      });
    }

    var zoomOutBtn = document.getElementById("places-ctrl-zoom-out");
    if (zoomOutBtn) {
      zoomOutBtn.addEventListener("click", function () {
        if (map) map.zoomOut();
      });
    }

    var fsBtn = document.getElementById("places-ctrl-fullscreen");
    var mapFrame = document.querySelector(".places-map-frame");
    if (fsBtn && mapFrame) {
      fsBtn.addEventListener("click", function () {
        var active = !!(
          document.fullscreenElement === mapFrame ||
          document.webkitFullscreenElement === mapFrame
        );
        if (active) {
          if (document.exitFullscreen) document.exitFullscreen();
          else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
        } else if (mapFrame.requestFullscreen) {
          mapFrame.requestFullscreen();
        } else if (mapFrame.webkitRequestFullscreen) {
          mapFrame.webkitRequestFullscreen();
        }
      });
      var onFsChange = function () {
        if (map) window.setTimeout(function () { map.resize(); }, 80);
      };
      document.addEventListener("fullscreenchange", onFsChange);
      document.addEventListener("webkitfullscreenchange", onFsChange);
    }
  }

  function destroyMap() {
    try {
      clearMarkers();
      clearAreas();
    } catch (e) {}
    infoWindow = null;
    ignorePopupCloseState = false;
    if (map) {
      try {
        map.destroy();
      } catch (e2) {}
      map = null;
    }
    uiBound = false;
  }

  function scheduleMapResize() {
    if (!map) return;
    [0, 80, 200, 450, 900].forEach(function (ms) {
      window.setTimeout(function () {
        if (!map) return;
        try {
          map.resize();
        } catch (e) {}
      }, ms);
    });
  }

  function resetAmapLoadCache() {
    amapLoadPromise = null;
    window.__placesAmapPromise = null;
  }

  function loadAmap() {
    if (browserWindow.AMap) return Promise.resolve(browserWindow.AMap);
    if (amapLoadPromise) return amapLoadPromise;
    if (window.__placesAmapPromise) {
      amapLoadPromise = window.__placesAmapPromise;
      return amapLoadPromise;
    }

    amapLoadPromise = new Promise(function (resolve, reject) {
      if (!amapKey) {
        reject(new Error("NO_KEY"));
        return;
      }
      if (amapSecurityJsCode) {
        window._AMapSecurityConfig = { securityJsCode: amapSecurityJsCode };
      }

      function doLoad() {
        if (!window.AMapLoader) {
          reject(new Error("NO_LOADER"));
          return;
        }
		var plugins = ["AMap.MarkerCluster", "AMap.Scale"];
		if (areaHighlightEnabled) plugins.push("AMap.DistrictSearch");
        if (reverseGeocode) plugins.push("AMap.Geocoder");
        window.AMapLoader.load({
          key: amapKey,
          version: "2.0",
          plugins: plugins,
        })
          .then(function (AMap) {
            resolve(AMap);
          })
          .catch(reject);
      }

      if (window.AMapLoader) {
        doLoad();
        return;
      }

      var existing = document.querySelector(
        'script[data-places-amap-loader="1"]',
      );
      if (existing) {
        existing.addEventListener("load", doLoad);
        existing.addEventListener("error", function () {
          reject(new Error("SCRIPT"));
        });
        return;
      }

      var script = document.createElement("script");
      script.src = "https://webapi.amap.com/loader.js";
      script.setAttribute("data-places-amap-loader", "1");
      script.onload = doLoad;
      script.onerror = function () {
        reject(new Error("SCRIPT"));
      };
      document.head.appendChild(script);
    }).catch(function (err) {
      resetAmapLoadCache();
      throw err;
    });

    window.__placesAmapPromise = amapLoadPromise;
    return amapLoadPromise;
  }

  function init() {
    var container = document.getElementById("places-amap");
    if (!container) return;

	syncClusterToggleState();

    loadingEl = document.getElementById("places-map-loading");
    if (loadingEl) loadingEl.classList.remove("is-hidden");

    var token = ++initToken;

    // 已有可用实例：只补 resize（Swup/Loader 后尺寸常为 0）
    if (map && container.querySelector("canvas, .amap-layers")) {
      hideLoading();
      bindUi(browserWindow.AMap);
      scheduleMapResize();
      return;
    }

    destroyMap();

    loadAmap()
      .then(function (AMap) {
        if (token !== initToken) return;
        var el = document.getElementById("places-amap");
        if (!el) return;

        map = new AMap.Map("places-amap", {
          viewMode: "2D",
          zoom: 5,
          center: [108.94, 34.34],
          mapStyle: "amap://styles/whitesmoke",
        });
        map.on("complete", function () {
          scheduleMapResize();
          // 如果有待处理的卡片点击，自动跳转
          waitForMapAndJump();
        });
        map.addControl(new AMap.Scale());
        hideLoading();
        bindUi(AMap);
        refreshMap(AMap);
        if (reverseGeocode) {
          void hydrateMissingAdministrativeInfo(AMap).then(function (changed) {
            if (!changed || token !== initToken || !map) return;
            renderContentForState();
            refreshMap(AMap);
          });
        }
        scheduleMapResize();
        if (window.ResizeObserver && el) {
          var resizeObserver = new ResizeObserver(function () {
            if (!map) return;
            var rect = el.getBoundingClientRect();
            if (rect.width > 0 && rect.height > 0) {
              try {
                map.resize();
              } catch (e) {}
            }
          });
          resizeObserver.observe(el);
        }
      })
      .catch(function (err) {
        if (token !== initToken) return;
        if (err && err.message === "NO_KEY") {
          showMessage(placesI18n.needAmapKey);
        } else {
          showMessage(placesI18n.mapLoadFailed);
          console.error("[places-amap]", err);
        }
      });
  }

  var bootTimer = null;

  function isLoaderVisible() {
    var loader = document.getElementById("page-loader");
    return !!(
      loader &&
      !loader.hidden &&
      !loader.classList.contains("page-loader--hidden")
    );
  }

  function waitUntilLayoutReady() {
    return new Promise(function (resolve) {
      var settled = false;
      function finish() {
        if (settled) return;
        settled = true;
        var el = document.getElementById("places-amap");
        if (!el) {
          resolve(false);
          return;
        }
        var tries = 0;
        function waitSize() {
          var rect = el.getBoundingClientRect();
          if ((rect.width > 48 && rect.height > 48) || tries >= 72) {
            window.requestAnimationFrame(function () {
              window.setTimeout(function () {
                resolve(true);
              }, 60);
            });
            return;
          }
          tries += 1;
          window.requestAnimationFrame(waitSize);
        }
        waitSize();
      }

      if (
        !isLoaderVisible() &&
        !document.documentElement.classList.contains("is-page-loading")
      ) {
        finish();
        return;
      }

      document.addEventListener("firefly:page-loader-hidden", finish, {
        once: true,
      });
      window.setTimeout(finish, 3200);
    });
  }

  function scheduleBoot(delay) {
    window.clearTimeout(bootTimer);
    bootTimer = window.setTimeout(function () {
      if (!document.getElementById("places-amap")) return;
      void waitUntilLayoutReady().then(function (ok) {
        if (!ok || !document.getElementById("places-amap")) return;
        init();
      });
    }, typeof delay === "number" ? delay : 48);
  }

  function onPlacesPageEnter(fromSwup) {
    if (fromSwup) {
	  mapMode = "overview";
	  selectedCityKey = null;
	  selectedTripId = null;
	  selectedLocationKey = null;
	  pendingTarget = null;
      destroyMap();
      resetAmapLoadCache();
    }
    if (!document.getElementById("places-amap")) return;
    renderContentForState();
    scheduleBoot(fromSwup ? 100 : 48);
  }

  function onPlacesPageReady() {
    if (!document.getElementById("places-amap")) return;
    var canvas = document
      .getElementById("places-amap")
      .querySelector("canvas, .amap-layers");
    if (map && canvas) {
      hideLoading();
      scheduleMapResize();
      return;
    }
    scheduleBoot(48);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function () {
      onPlacesPageEnter(false);
    });
  } else {
    window.requestAnimationFrame(function () {
      onPlacesPageEnter(false);
    });
  }

  document.addEventListener("swup:contentReplaced", function () {
    onPlacesPageEnter(true);
  });
  document.addEventListener("swup:content:replace", function () {
    onPlacesPageEnter(true);
  });
  document.addEventListener("swup:page:view", onPlacesPageReady);
  document.addEventListener("astro:page-load", onPlacesPageReady);
  document.addEventListener("firefly:page-loader-hidden", onPlacesPageReady);

  if (window.swup && window.swup.hooks) {
    window.swup.hooks.on("content:replace", function () {
      onPlacesPageEnter(true);
    });
    window.swup.hooks.on("page:view", onPlacesPageReady);
  } else {
    document.addEventListener(
      "swup:enable",
      function () {
        if (!window.swup || !window.swup.hooks) return;
        window.swup.hooks.on("content:replace", function () {
          onPlacesPageEnter(true);
        });
        window.swup.hooks.on("page:view", onPlacesPageReady);
      },
      { once: true },
    );
  }
})();
</script>
