PRESENCE_API_URL=http://localhost:4321/api/presence/update/
# 本地开发 API 不需要 Token，可以留空。
PRESENCE_TOKEN=
PRESENCE_DETECT_INTERVAL=5000
PRESENCE_HEARTBEAT_INTERVAL=30000
PRESENCE_IDLE_TIMEOUT=600000

# 生产环境示例（请通过当前 PowerShell 环境变量注入真实值）：
