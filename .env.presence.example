# 以下运行参数均为 presenceConfig.agent 默认值的可选 override。
# 留空时继续使用 src/config/presenceConfig.ts 中的默认值。
PRESENCE_API_URL=
PRESENCE_DETECT_INTERVAL=
PRESENCE_HEARTBEAT_INTERVAL=
PRESENCE_IDLE_TIMEOUT=

# Token 例外：只从环境变量读取，没有配置文件默认值；本地开发可留空。
PRESENCE_TOKEN=

# 生产环境示例（请通过当前 PowerShell 环境变量注入真实值）：
# PRESENCE_API_URL=https://example.com/api/presence/update/
# PRESENCE_TOKEN=replace-with-your-secret-token
